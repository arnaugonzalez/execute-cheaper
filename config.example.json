        "flash": "glm-5.3-flash",
        "pro": "glm-5.3"
      },
      "max_budget_usd": 2.0,
      "timeout_s": 3600,
      "billing": "paid",
      "prices": {
        "glm-5.3-flash": [
          0.15,
          0.03,
          0.5
        ],
        "glm-5.3": [
          1.4,
          0.26,
          4.4
        ]
      }
    },
    "anthropic": {
      "kind": "claude",
      "key_env": "ANTHROPIC_API_KEY",
      "models": {
        "flash": "haiku",
        "pro": "sonnet"
      },
      "timeout_s": 3600,
      "billing": "paid"
    },
    "claude-login": {
      "kind": "claude",
      "use_login": true,
      "models": {
        "flash": "haiku",
        "pro": "sonnet"
      },
      "timeout_s": 3600,
      "billing": "subscription"
