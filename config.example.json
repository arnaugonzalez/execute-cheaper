{
  "chain": [
    "codex",
    "copilot",
    "openrouter"
  ],
  "verify": {
    "provider": "claude-login",
    "tier": "pro",
    "timeout_s": 1800
  },
  "max_rounds": 2,
  "on_event": null,
  "prices_as_of": "2026-09-24",
  "providers": {
    "codex": {
      "kind": "codex",
      "models": {
        "flash": "gpt-5.6-luna",
        "pro": "gpt-5.6-terra"
      },
      "timeout_s": 3600,
      "billing": "subscription"
    },
    "copilot": {
      "kind": "cli",
      "cmd": [
        "copilot",
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--yolo",
        "--no-ask-user",
        "--no-auto-update",
        "--disable-builtin-mcps",
        "--no-color",
        "-s",
        "--usage-output-file",
        "{run_dir}/{label}-usage.json"
      ],
      "fail_re": "^Execution failed",
      "usage_file": "{run_dir}/{label}-usage.json",
      "usage": {
        "input_tokens": "tokenDetails.input.tokenCount",
        "cache_read_input_tokens": "tokenDetails.cache_read.tokenCount",
        "cache_creation_input_tokens": "tokenDetails.cache_write.tokenCount",
        "output_tokens": "tokenDetails.output.tokenCount"
      },
      "models": {
        "flash": "auto",
        "pro": "auto"
      },
      "timeout_s": 3600,
      "billing": "subscription"
    },
    "opencode": {
      "kind": "cli",
      "cmd": [
        "opencode",
        "run",
        "--standalone",
        "--auto",
        "--format",
        "json",
        "--title",
        "execute-cheaper {label}",
        "-m",
        "{model}",
        "{prompt}"
      ],
      "output": "jsonl",
      "text_field": "part.text",
      "fail_re": "^\\{\"type\":\"error\"",
      "usage": {
        "input_tokens": "part.tokens.input",
        "cache_read_input_tokens": "part.tokens.cache.read",
        "cache_creation_input_tokens": "part.tokens.cache.write",
        "output_tokens": "part.tokens.output",
        "thinking_tokens": "part.tokens.reasoning"
      },
      "cost_field": "part.cost",
      "models": {
        "flash": "opencode/mimo-v2.6-flash-free",
        "pro": "opencode/nemotron-3-ultra-free"
      },
      "timeout_s": 3600,
      "billing": "paid"
    },
    "cursor": {
      "kind": "cli",
      "cmd": [
        "cursor-agent",
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--output-format",
        "text",
        "--force"
      ],
      "models": {
        "flash": "auto",
        "pro": "auto"
      },
      "timeout_s": 3600,
      "billing": "subscription"
    },
    "agy": {
      "kind": "agy",
      "models": {
        "flash": "gemini-3.8-flash-high",
        "pro": "gemini-3.1-pro-high"
      },
      "timeout_s": 3600,
      "inactivity_s": 600,
      "quota_hits_to_abort": 2,
      "billing": "subscription"
    },
    "openrouter": {
      "kind": "claude",
      "base_url": "https://openrouter.ai/api",
      "key_env": "OPENROUTER_API_KEY",
      "env": {
        "ANTHROPIC_API_KEY": "$KEY"
      },
      "models": {
        "flash": "deepseek/deepseek-v4.1-flash",
        "pro": "z-ai/glm-5.3"
      },
      "max_budget_usd": 2.0,
      "timeout_s": 3600,
      "billing": "paid",
      "prices": {
        "deepseek/deepseek-v4.1-flash": [
          0.14,
          0.0042,
          0.42
        ],
        "z-ai/glm-5.3": [
          1.4,
          0.26,
          4.4
        ],
        "anthropic/claude-sonnet-5": [
          2.0,
          0.2,
          10.0,
          2.5
        ]
      }
    },
    "deepseek": {
      "kind": "claude",
      "base_url": "https://api.deepseek.com/anthropic",
      "key_env": "DEEPSEEK_API_KEY",
      "models": {
        "flash": "deepseek-flash",
        "pro": "deepseek-v4-pro"
      },
      "max_budget_usd": 2.0,
      "timeout_s": 3600,
      "billing": "paid",
      "prices": {
        "deepseek-flash": [
          0.15,
          0.003,
          0.6
        ],
        "deepseek-v4-pro": [
          0.66,
          0.022,
          1.98
        ]
      },
      "tool_prices": {
        "web_search_requests": 0.00075,
        "web_fetch_requests": 0.00075
      },
      "tool_prices_since": "2026-10-31T16:00:00+00:00",
      "peak": {
        "multiplier": 2.0,
        "utc_hours": [
          [
            1,
            4
          ],
          [
            6,
            10
          ]
        ],
        "weekdays_only": true
      }
