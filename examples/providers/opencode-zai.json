{
  "opencode-zai": {
    "kind": "cli",
    "cmd": [
      "opencode",
      "run",
      "--standalone",
      "--auto",
      "--format",
      "json",
      "--title",
      "execute-cheaper {label}",
      "-m",
      "{model}",
      "{prompt}"
    ],
    "output": "jsonl",
    "text_field": "part.text",
    "fail_re": "^\\{\"type\":\"error\"",
    "usage": {
      "input_tokens": "part.tokens.input",
      "cache_read_input_tokens": "part.tokens.cache.read",
      "cache_creation_input_tokens": "part.tokens.cache.write",
      "output_tokens": "part.tokens.output",
      "thinking_tokens": "part.tokens.reasoning"
    },
    "cost_field": "part.cost",
    "models": {
      "flash": "zai-coding-plan/glm-5.3-flash",
      "pro": "zai-coding-plan/glm-5.3"
    },
    "timeout_s": 3600,
    "billing": "subscription",
    "quota_reset_s": 18000,
    "prices": {
      "zai-coding-plan/glm-5.3-flash": [
        0.15,
        0.03,
        0.5
      ],
      "zai-coding-plan/glm-5.3": [
        1.4,
        0.26,
        4.4
      ]
    }
  }
}
